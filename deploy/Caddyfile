# Caddy obtains and renews a TLS certificate automatically.
# The hostname comes from GUITHUB_DOMAIN in .env.

{
	email {$ACME_EMAIL}
}

{$GUITHUB_DOMAIN} {
	encode gzip

	# Uploads are capped in the app too; this stops an oversized body ever
	# reaching Node.
	request_body {
		max_size 25MB
	}

	reverse_proxy guithub:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
	}
}
