{
  "name": "guithub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @guithub/core && npm run build -w @guithub/server && npm run build -w @guithub/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node packages/server/dist/main.js",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=20.19"
  }
}
